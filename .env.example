# Telegram Bot Admin Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_ADMIN_CHAT_ID="your_telegram_admin_chat_id_here"
TELEGRAM_WEBHOOK_SECRET="your_telegram_webhook_secret_here"

# Cryptographic Salted Secret Digest for Revoke Confirmations (SHA-256)
# Default is SHA-256 digest of secret code "2232"
REVOKE_SECURITY_HASH="48fe0661615dd0a2fc9cf1b77111613b4c3e7fc857b7bf89e472c233a0b35eb0"

# Supabase Cloud Database & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-for-server-only"

# Cloudflare R2 / AWS S3 Storage
S3_ENDPOINT="https://auto.r2.cloudflarestorage.com"
S3_BUCKET_NAME="edufinance-cloud-storage"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_DOMAIN="https://assets.edufinance.pro"

# Upstash Cloud Memory (Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
